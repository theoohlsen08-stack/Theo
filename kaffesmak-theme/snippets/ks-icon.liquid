{%- comment -%}
  KaffeSmak – enkla ikoner som inline-SVG. Parametrar: icon (namn), size (px, standard 24).
{%- endcomment -%}
{%- assign s = size | default: 24 -%}
{%- case icon -%}
  {%- when 'cup' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 44 44" aria-hidden="true" focusable="false"><path d="M15 4c-2 2.2 2 3.8 0 6.6M20.5 2.5c-2.4 2.6 2.4 4.6 0 7.8M26 4c-2 2.2 2 3.8 0 6.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M6 15h28v4.2c0 9.6-6.3 17.3-14 17.3S6 28.8 6 19.2V15z" fill="currentColor"/><path d="M33 18.5h2.2a5.3 5.3 0 0 1 0 10.6h-3.6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M8 39.5h24" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
  {%- when 'map' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.6A2.6 2.6 0 1 1 12 6.4a2.6 2.6 0 0 1 0 5.2z" fill="currentColor"/></svg>
  {%- when 'phone' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" fill="currentColor"/></svg>
  {%- when 'beans' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="8.5" cy="13" rx="5" ry="7" transform="rotate(-30 8.5 13)" fill="currentColor"/><path d="M5.3 18.2c2-2.6 1.6-5.4 2.9-7.6 1-1.7 2.7-2.5 3.6-3.3" fill="none" stroke="#000" stroke-opacity=".35" stroke-width="1.3"/><ellipse cx="16.5" cy="9" rx="4" ry="5.6" transform="rotate(35 16.5 9)" fill="currentColor"/></svg>
  {%- when 'play' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor"/><path d="M10 9l5 3-5 3z" fill="#000" fill-opacity=".55"/></svg>
  {%- when 'star' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.2 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
  {%- when 'facebook' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4a20 20 0 0 0-2.2-.1c-2.2 0-3.7 1.3-3.7 3.8v2.4H8.1v3h2.5V21z" fill="currentColor"/></svg>
  {%- when 'instagram' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/></svg>
  {%- when 'youtube' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15V9l5.2 3z" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v3.1a7 7 0 0 1-3.9-1.2v6.1a5.9 5.9 0 1 1-5.9-5.9h.6v3.2a2.8 2.8 0 1 0 2.2 2.7V3z" fill="currentColor"/></svg>
  {%- when 'linkedin' -%}
    <svg class="ks-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 9h3.2v11H4.5zM6.1 3.8a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8zM10 9h3v1.5c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.2 2.3 4.2 5.3v6h-3.2v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V20H10z" fill="currentColor"/></svg>
{%- endcase -%}
