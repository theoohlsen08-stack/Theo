{%- comment -%}
  KaffeSmak – guldbrunt informationsband under bannern (Monteriva-referensens infoband):
  en centrerad rad med punkter åtskilda av mittpunkter. Varje punkt är ett eget block.
  Rättelse efter etapp 5: mörkare guldbrunt (#8A6A40) så att den vita texten har kontrast 4,98:1 (tidigare #A38358, 3,53:1).
{%- endcomment -%}

{{ 'ks-theme.css' | asset_url | stylesheet_tag }}

<section class="ks-band" style="--ks-band-bg: {{ section.settings.background }};">
  <ul class="ks-container ks-band__list" role="list">
    {%- for block in section.blocks -%}
      <li class="ks-band__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "KaffeSmak infoband",
  "class": "ks-band-section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "background", "label": "Bakgrund", "default": "#8A6A40", "info": "Vit text kräver kontrast minst 4,5:1 mot bakgrunden (#8A6A40 ger 4,98:1)." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Kaffebar och rosteri i Sollefteå" },
        { "type": "url", "id": "link", "label": "Länk" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KaffeSmak infoband",
      "blocks": [
        { "type": "item", "settings": { "text": "Kaffebar och rosteri på Storgatan 55 i Sollefteå" } },
        { "type": "item", "settings": { "text": "Ring oss: 076-270 89 27" } }
      ]
    }
  ]
}
{% endschema %}
