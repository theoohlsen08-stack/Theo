{%- comment -%}
  KaffeSmak – Monteriva-inspirerat sidhuvud.
  Svart toppfält (logga, sökfält, konto, varukorg, Kontakt-knapp) och röd huvudmeny
  med nedfällbara undermenyer som öppnas vid klick. Menyn hämtas från en Shopify-meny.
  Etapp 5: undermenyernas rader byggs av snippet ks-nav-children (samma regler på dator och mobil): tomma länkar,
  länkar till saknade eller opublicerade resurser (snippet ks-link-usable) och platshållare till huvudpunktens sida
  visas inte, och aktuell sida markeras
  med aria-current på högst en rad per undermeny (snippet ks-nav-current hanterar ?view=-länkar som Om oss).
{%- endcomment -%}

{%- liquid
  assign menu = linklists[section.settings.menu]

  # Etapp 5: menyns vy-namn (länkar med ?view=X, t.ex. Om oss på /pages/contact?view=om-oss) som '|om-oss|'.
  # Används för att markera rätt rad som aktuell sida (snippet ks-nav-current).
  assign ks_view_names = '|'
  for top in menu.links
    if top.url contains '?view=' or top.url contains '&view='
      assign ks_view = top.url | split: 'view=' | last | split: '&' | first | split: '#' | first
      assign ks_view_names = ks_view_names | append: ks_view | append: '|'
    endif
    for child in top.links
      if child.url contains '?view=' or child.url contains '&view='
        assign ks_view = child.url | split: 'view=' | last | split: '&' | first | split: '#' | first
        assign ks_view_names = ks_view_names | append: ks_view | append: '|'
      endif
    endfor
  endfor

  assign nav_font = section.settings.nav_font
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign nav_font_bold = nav_font | font_modify: 'weight', '600'
  assign logo_alt = section.settings.logo_alt | default: shop.name
-%}

<style>
  {{ nav_font | font_face: font_display: 'swap' }}
  {{ nav_font_bold | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  :root {
    --ks-black: {{ section.settings.color_header }};
    --ks-red: {{ section.settings.color_nav }};
    --ks-red-dark: {{ section.settings.color_dropdown }};
    --ks-green: {{ section.settings.color_button }};
    --ks-icon-red: {{ section.settings.color_icons }};
    --ks-font-nav: {{ nav_font.family }}, {{ nav_font.fallback_families }};
    --ks-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --ks-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --ks-logo-height: {{ section.settings.logo_height }}px;
    --ks-logo-height-mobile: {{ section.settings.logo_height_mobile }}px;
  }
</style>

{{ 'ks-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ks-header.js' | asset_url }}" defer></script>

<ks-header class="ks-header{% if section.settings.sticky %} ks-header--sticky{% endif %}">
  <div class="ks-header__top">
    <div class="ks-container ks-header__top-inner">
      <button
        type="button"
        class="ks-header__burger"
        aria-expanded="false"
        aria-controls="KsMobileNav-{{ section.id }}"
        data-ks-burger
      >
        <span class="ks-visually-hidden">Meny</span>
        <svg aria-hidden="true" focusable="false" width="26" height="20" viewBox="0 0 26 20"><path d="M0 1h26M0 10h26M0 19h26" stroke="currentColor" stroke-width="2.4"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="ks-header__logo"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: height: 300
            | image_tag: alt: logo_alt, class: 'ks-header__logo-img', loading: 'eager', fetchpriority: 'high'
          }}
        {%- elsif section.settings.logo_asset != blank -%}
          <img
            src="{{ section.settings.logo_asset | asset_url }}"
            alt="{{ logo_alt | escape }}"
            class="ks-header__logo-img"
            width="571"
            height="480"
            fetchpriority="high"
          >
        {%- else -%}
          <span class="ks-header__logo-text">{{ logo_alt }}</span>
        {%- endif -%}
      </a>

      {%- comment -%}
        Sökförslag (etapp 4): ks-header.js hämtar sektionen ks-predictive-search från data-ks-suggest-url när minst
        två tecken skrivits och visar förslagen i listan nedan (kombinationsruta med pilar, Enter och Escape).
        Formuläret skickas som tidigare med type=product till sökresultatsidan.
      {%- endcomment -%}
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="ks-search"
        data-ks-suggest-url="{{ routes.predictive_search_url }}"
      >
        <label for="KsSearch-{{ section.id }}" class="ks-visually-hidden">{{ section.settings.search_placeholder }}</label>
        <input
          id="KsSearch-{{ section.id }}"
          class="ks-search__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off"
        >
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="ks-search__button">
          <span class="ks-visually-hidden">Sök</span>
          <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22"><circle cx="9" cy="9" r="6.6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M14 14l6 6" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
        </button>
        <div class="ks-suggest" data-ks-suggest-panel hidden>
          <ul class="ks-suggest__list" id="KsSuggest-{{ section.id }}" role="listbox" aria-label="Sökförslag"></ul>
          <p class="ks-suggest__empty" data-ks-suggest-empty hidden></p>
        </div>
        <p class="ks-visually-hidden" role="status" data-ks-suggest-status></p>
      </form>

      <div class="ks-header__actions">
        {% render 'header-actions',
          customer_account_menu: section.settings.customer_account_menu,
          display_style: 'icon',
          section: section
        %}
        {%- if section.settings.contact_label != blank -%}
          <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="ks-button ks-button--green ks-header__contact">
            <span class="ks-header__contact-label">{{ section.settings.contact_label }}</span>
            <span class="ks-header__contact-arrow" aria-hidden="true">
              <svg width="8" height="12" viewBox="0 0 8 12" focusable="false"><path d="M1.5 1.5L6 6l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if menu.links.size > 0 -%}
    <nav class="ks-nav" aria-label="Huvudmeny">
      <div class="ks-container">
        <ul class="ks-nav__list" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign item_id = 'KsNav-' | append: section.id | append: '-' | append: forloop.index
              # Huvudpunktens länk används bara när den finns, inte är '#' och inte pekar på en saknad eller opublicerad
              # resurs (snippet ks-link-usable).
              assign top_url = ''
              capture ks_usable
                render 'ks-link-usable', link: link
              endcapture
              if ks_usable contains 'true'
                assign top_url = link.url
              endif
              capture ks_children
                render 'ks-nav-children', link: link, top_url: top_url, variant: 'desktop', show_view_all: section.settings.show_view_all, view_all_label: section.settings.view_all_label, hide_same: section.settings.hide_duplicate_links, view_names: ks_view_names, view_suffix: template.suffix
              endcapture
              assign ks_children = ks_children | strip
            -%}
            {%- comment -%} Ingen undermeny och ingen egen länk: menypunkten skrivs inte ut (aldrig en död länk till #). {%- endcomment -%}
            {%- if ks_children == '' and top_url == blank -%}{%- continue -%}{%- endif -%}
            <li class="ks-nav__item{% if ks_children != '' %} ks-nav__item--parent{% endif %}{% if link.active or link.child_active %} ks-nav__item--current{% endif %}">
              {%- if ks_children != '' -%}
                <button
                  type="button"
                  class="ks-nav__top"
                  aria-expanded="false"
                  aria-controls="{{ item_id }}"
                  data-ks-toggle
                >
                  <span>{{ link.title }}</span>
                  <svg class="ks-nav__caret" aria-hidden="true" focusable="false" width="10" height="6" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                </button>
                <ul class="ks-dropdown" id="{{ item_id }}" role="list" hidden>
                  {{ ks_children }}
                </ul>
              {%- else -%}
                {%- capture ks_cur -%}{%- render 'ks-nav-current', link: link, view_names: ks_view_names, view_suffix: template.suffix -%}{%- endcapture -%}
                <a
                  class="ks-nav__top"
                  href="{{ top_url }}"
                  {% if ks_cur contains 'true' %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    <div class="ks-mobile-nav" id="KsMobileNav-{{ section.id }}" hidden>
      <ul class="ks-mobile-nav__list" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign m_id = 'KsMobile-' | append: section.id | append: '-' | append: forloop.index
            assign top_url = ''
            capture ks_usable
              render 'ks-link-usable', link: link
            endcapture
            if ks_usable contains 'true'
              assign top_url = link.url
            endif
            capture ks_children
              render 'ks-nav-children', link: link, top_url: top_url, variant: 'mobile', show_view_all: section.settings.show_view_all, view_all_label: section.settings.view_all_label, hide_same: section.settings.hide_duplicate_links, view_names: ks_view_names, view_suffix: template.suffix
            endcapture
            assign ks_children = ks_children | strip
          -%}
          {%- if ks_children == '' and top_url == blank -%}{%- continue -%}{%- endif -%}
          <li class="ks-mobile-nav__item{% if link.active or link.child_active %} ks-mobile-nav__item--current{% endif %}">
            {%- if ks_children != '' -%}
              <button
                type="button"
                class="ks-mobile-nav__top"
                aria-expanded="false"
                aria-controls="{{ m_id }}"
                data-ks-accordion
              >
                <span>{{ link.title }}</span>
                <svg class="ks-nav__caret" aria-hidden="true" focusable="false" width="12" height="8" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
              <ul class="ks-mobile-nav__sub" id="{{ m_id }}" role="list" hidden>
                {{ ks_children }}
              </ul>
            {%- else -%}
              {%- capture ks_cur -%}{%- render 'ks-nav-current', link: link, view_names: ks_view_names, view_suffix: template.suffix -%}{%- endcapture -%}
              <a class="ks-mobile-nav__top" href="{{ top_url }}"{% if ks_cur contains 'true' %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.contact_label != blank -%}
        <div class="ks-mobile-nav__footer">
          <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="ks-button ks-button--green">
            {{- section.settings.contact_label -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</ks-header>

{% schema %}
{
  "name": "KaffeSmak sidhuvud",
  "class": "ks-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Logotyp" },
    { "type": "image_picker", "id": "logo", "label": "Logotyp (vit på svart)" },
    {
      "type": "text",
      "id": "logo_asset",
      "label": "Logotyp från temafiler (filnamn i assets)",
      "default": "ks-logo-vit.png",
      "info": "Används om ingen bild valts ovan. Lämna tomt för att visa butiksnamnet."
    },
    { "type": "text", "id": "logo_alt", "label": "Alt-text", "default": "Kaffe Smak Rosteri" },
    { "type": "range", "id": "logo_height", "label": "Logotypens höjd, dator", "min": 60, "max": 148, "step": 2, "unit": "px", "default": 132 },
    { "type": "range", "id": "logo_height_mobile", "label": "Logotypens höjd, mobil", "min": 36, "max": 90, "step": 2, "unit": "px", "default": 64 },
    { "type": "header", "content": "Meny" },
    { "type": "link_list", "id": "menu", "label": "Huvudmeny", "default": "main-menu" },
    { "type": "checkbox", "id": "show_view_all", "label": "Visa länken \"Visa alla\" i undermenyn", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Text för \"Visa alla\"", "default": "Visa alla" },
    {
      "type": "checkbox",
      "id": "hide_duplicate_links",
      "label": "Dölj undermenylänkar som går till samma sida som huvudlänken",
      "default": true,
      "info": "Platshållare som pekar på huvudkategorin visas inte; \"Visa alla\" leder dit. Länkar till opublicerade kategorier, produkter och sidor visas aldrig."
    },
    { "type": "link_list", "id": "customer_account_menu", "label": "Kundkontomeny", "default": "customer-account-main-menu" },
    { "type": "header", "content": "Sök och kontakt" },
    { "type": "text", "id": "search_placeholder", "label": "Text i sökfältet", "default": "Sök produkter" },
    { "type": "text", "id": "contact_label", "label": "Kontaktknappens text", "default": "Kontakt" },
    { "type": "url", "id": "contact_link", "label": "Kontaktknappens länk" },
    { "type": "checkbox", "id": "sticky", "label": "Fäst sidhuvudet vid skrollning", "default": false },
    { "type": "header", "content": "Färger" },
    { "type": "color", "id": "color_header", "label": "Sidhuvud", "default": "#000000" },
    { "type": "color", "id": "color_nav", "label": "Huvudmeny", "default": "#C10C29" },
    { "type": "color", "id": "color_dropdown", "label": "Undermeny", "default": "#9F0922" },
    { "type": "color", "id": "color_button", "label": "Kontakt- och sökknapp", "default": "#2C8420" },
    { "type": "color", "id": "color_icons", "label": "Konto- och varukorgsikoner", "default": "#D91441" },
    { "type": "header", "content": "Typsnitt" },
    { "type": "font_picker", "id": "nav_font", "label": "Meny och knappar", "default": "barlow_condensed_n4" },
    { "type": "font_picker", "id": "heading_font", "label": "Stora rubriker", "default": "jost_n5" },
    { "type": "font_picker", "id": "body_font", "label": "Brödtext", "default": "noto_sans_n4" }
  ]
}
{% endschema %}
