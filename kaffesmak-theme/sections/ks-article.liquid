{%- comment -%}
  KaffeSmak – artikel i bloggen (Kunskap/Nyheter), etapp 5. Samma formgivning som Om oss (ks-pages.css):
  centrerad röd H1 (artikelns titel), datum, artikelns bild bara när den finns och texten i en kolumn på 850 px
  med radavstånd 2. Ingen kommentarsdel. Strukturerad data som i Horizons artikelmall.
  Används av templates/article.json.
{%- endcomment -%}

{{ 'ks-shop.css' | asset_url | stylesheet_tag }}
{{ 'ks-pages.css' | asset_url | stylesheet_tag }}

{%- assign title_id = 'KsArticleTitle-' | append: section.id -%}

<article class="ks-shop ks-page ks-page--no-banner ks-article" aria-labelledby="{{ title_id }}">
  <div class="ks-page__main">
    <div class="ks-container">
      <header class="ks-article__header">
        <h1 class="ks-page-title ks-page__title ks-article__title" id="{{ title_id }}">{{ article.title | escape }}</h1>
        {%- if section.settings.show_date and article.published_at != blank -%}
          <p class="ks-article__date">{{ article.published_at | time_tag: format: 'date' }}</p>
        {%- endif -%}
      </header>

      {%- if article.image != blank -%}
        <div class="ks-article__image">
          {{
            article.image
            | image_url: width: 1700
            | image_tag:
              widths: '400, 600, 850, 1100, 1700',
              sizes: '(min-width: 900px) 850px, 100vw',
              alt: article.image.alt,
              loading: 'eager',
              class: 'ks-article__img'
          }}
        </div>
      {%- endif -%}

      {%- if article.content != blank -%}
        <div class="ks-page__body ks-article__body">{{ article.content }}</div>
      {%- endif -%}
    </div>
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "KaffeSmak artikel",
  "class": "ks-article-section",
  "tag": "section",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "checkbox", "id": "show_date", "label": "Visa publiceringsdatum", "default": true }
  ]
}
{% endschema %}
