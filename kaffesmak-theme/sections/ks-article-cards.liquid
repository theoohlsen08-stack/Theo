{%- comment -%}
  KaffeSmak – kunskapskort (referensens fyra kunskapskort på startsidan): de senaste artiklarna
  från en vald blogg som kort med bild (bara när artikeln har en), röd rubrik, kort text och grön knapp.
  Sektionen döljs helt när ingen blogg är vald eller bloggen saknar artiklar.
{%- endcomment -%}


{%- assign blog = section.settings.blog -%}
{%- if blog != blank and blog.articles_count > 0 -%}
  {{ 'ks-theme.css' | asset_url | stylesheet_tag }}
  <section class="ks-section ks-articles" aria-labelledby="KsArticles-{{ section.id }}">
    <div class="ks-container">
      <h2 class="ks-section__heading ks-section__heading--red" id="KsArticles-{{ section.id }}">
        {{- section.settings.heading | default: blog.title -}}
      </h2>
      {%- if section.settings.text != blank -%}
        <div class="ks-section__lead">{{ section.settings.text }}</div>
      {%- endif -%}
      <ul class="ks-articles__list" role="list">
        {%- for article in blog.articles limit: section.settings.limit -%}
          <li class="ks-article-card">
            {%- if article.image != blank -%}
              <a href="{{ article.url }}" class="ks-article-card__media" tabindex="-1" aria-hidden="true">
                {{
                  article.image
                  | image_url: width: 700
                  | image_tag: widths: '350, 500, 700', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', alt: '', loading: 'lazy', class: 'ks-article-card__img'
                }}
              </a>
            {%- endif -%}
            <div class="ks-article-card__body">
              <h3 class="ks-article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {%- comment -%}
                Utdrag: artikelns eget utdrag, annars början av texten. Mellanslag före slutet av block (stycke,
                rubrik 1–6, listpunkt, citat, tabellcell, bildtext, radbrytning) så att orden inte smälter ihop när
                HTML tas bort, som på bloggsidan (ks-blog).
              {%- endcomment -%}
              {%- liquid
                if article.excerpt != blank
                  assign ks_source = article.excerpt
                else
                  assign ks_source = article.content
                endif
                assign read_aria = section.settings.read_label | append: ': ' | append: article.title
              -%}
              {%- assign excerpt = ks_source
                | replace: '</p>', ' </p>'
                | replace: '</li>', ' </li>'
                | replace: '</h1>', ' </h1>'
                | replace: '</h2>', ' </h2>'
                | replace: '</h3>', ' </h3>'
                | replace: '</h4>', ' </h4>'
                | replace: '</h5>', ' </h5>'
                | replace: '</h6>', ' </h6>'
                | replace: '</blockquote>', ' </blockquote>'
                | replace: '</td>', ' </td>'
                | replace: '</th>', ' </th>'
                | replace: '</figcaption>', ' </figcaption>'
                | replace: '</div>', ' </div>'
                | replace: '<br', ' <br'
                | strip_html
                | strip
                | truncatewords: 24
              -%}
              {%- if excerpt != blank -%}
                <p class="ks-article-card__excerpt">{{ excerpt }}</p>
              {%- endif -%}
              {% render 'ks-button', label: section.settings.read_label, url: article.url, size: 'small', aria_label: read_aria %}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="ks-editor-note">KaffeSmak kunskapskort: {% if blog == blank %}ingen blogg vald{% else %}bloggen "{{ blog.title }}" har inga artiklar ännu{% endif %}. Sektionen syns inte för besökare förrän det finns artiklar.</div>
{%- endif -%}

{% schema %}
{
  "name": "KaffeSmak kunskapskort",
  "class": "ks-articles-section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blogg" },
    { "type": "text", "id": "heading", "label": "Rubrik", "info": "Tomt fält visar bloggens namn." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "label": "Antal artiklar", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "read_label", "label": "Knapptext", "default": "Läs mer" }
  ],
  "presets": [{ "name": "KaffeSmak kunskapskort" }]
}
{% endschema %}
