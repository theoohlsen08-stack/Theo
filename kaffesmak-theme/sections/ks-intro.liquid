{%- comment -%}
  KaffeSmak – beige introduktion (Monteriva-referensens första innehållssektion):
  brun ikonruta, stor brun rubrik och en smalare textkolumn till höger.
{%- endcomment -%}

{{ 'ks-theme.css' | asset_url | stylesheet_tag }}

<section
  class="ks-intro"
  style="--ks-intro-bg: {{ section.settings.background }}; --ks-intro-heading: {{ section.settings.heading_color }}; --ks-intro-icon-bg: {{ section.settings.icon_background }};"
>
  <div class="ks-intro__grid">
    {%- if section.settings.show_icon -%}
      <div class="ks-intro__icon" aria-hidden="true">
        {%- if section.settings.icon_image != blank -%}
          {{ section.settings.icon_image | image_url: width: 160 | image_tag: alt: '', class: 'ks-intro__icon-img', loading: 'lazy' }}
        {%- else -%}
          <svg width="44" height="44" viewBox="0 0 44 44" focusable="false">
            <path d="M15 4c-2 2.2 2 3.8 0 6.6M20.5 2.5c-2.4 2.6 2.4 4.6 0 7.8M26 4c-2 2.2 2 3.8 0 6.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M6 15h28v4.2c0 9.6-6.3 17.3-14 17.3S6 28.8 6 19.2V15z" fill="currentColor"/>
            <path d="M33 18.5h2.2a5.3 5.3 0 0 1 0 10.6h-3.6" fill="none" stroke="currentColor" stroke-width="3"/>
            <path d="M8 39.5h24" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
          </svg>
        {%- endif -%}
      </div>
    {%- endif -%}
    <h2 class="ks-intro__heading">{{ section.settings.heading }}</h2>
    <div class="ks-intro__text">
      {{ section.settings.text }}
      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="ks-intro__buttons">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="ks-button ks-button--green">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="ks-button ks-button--outline">
              {{- section.settings.button2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KaffeSmak introduktion",
  "class": "ks-intro-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Välkommen till Kaffe Smak Rosteri." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Fetstil visas som mörkare text, som i referensen.",
      "default": "<p>Utforska vårt sortiment av kaffe, kaffemaskiner och tillbehör, eller <strong>besök vår kaffebar på Storgatan 55 i Sollefteå.</strong></p>"
    },
    { "type": "checkbox", "id": "show_icon", "label": "Visa ikon", "default": true },
    { "type": "image_picker", "id": "icon_image", "label": "Egen ikon (valfri)", "info": "Utan egen bild visas en vit kaffekopp." },
    { "type": "header", "content": "Valfria knappar" },
    { "type": "text", "id": "button_label", "label": "Knapp 1, text" },
    { "type": "url", "id": "button_link", "label": "Knapp 1, länk" },
    { "type": "text", "id": "button2_label", "label": "Knapp 2, text" },
    { "type": "url", "id": "button2_link", "label": "Knapp 2, länk" },
    { "type": "header", "content": "Färger" },
    { "type": "color", "id": "background", "label": "Bakgrund", "default": "#E2D8C8" },
    { "type": "color", "id": "heading_color", "label": "Rubrikfärg", "default": "#653A2B" },
    { "type": "color", "id": "icon_background", "label": "Ikonruta", "default": "#653A2B" }
  ],
  "presets": [{ "name": "KaffeSmak introduktion" }]
}
{% endschema %}
