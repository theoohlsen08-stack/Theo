{%- comment -%}
  KaffeSmak – informationskort på beige bakgrund (referensens "Därför väljer du ..."):
  tre färgade kort med ikon, rubrik, text och grön knapp. Kort utan rubrik döljs,
  och hela sektionen döljs när inget kort har innehåll.
  Slututkast 2026-10-07 (startsidans erbjudanden, sektionen ks_guides i templates/index.json):
  - "Erbjudande": kortets text blir kundens erbjudande ur temainställningarna (KaffeSmak › Erbjudanden), ordagrant,
    så att texten bara finns på ett ställe.
  - "Kategori" + "Visa bara när kategorin är publicerad och har produkter": kortet visas bara när kategorin går att
    öppna i webbutiken (snippet ks-collection-live) och har produkter. Utan egen knapplänk länkar knappen till
    kategorin. Hela sektionen döljs när inget kort visas (en anteckning syns i temaredigeraren).
{%- endcomment -%}


{%- assign hidden_cards = 0 -%}
{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign card_show = true
      assign card_link = block.settings.link
      assign card_collection = block.settings.collection
      if block.settings.only_when_live
        assign card_show = false
        if card_collection != blank and card_collection.products_count > 0
          capture card_live
            render 'ks-collection-live', collection: card_collection
          endcapture
          if card_live contains 'true'
            assign card_show = true
          endif
        endif
      endif
      if card_link == blank and card_collection != blank
        assign card_link = card_collection.url
      endif
      assign card_text = block.settings.text
      if block.settings.offer != blank and block.settings.offer != 'none'
        assign card_text = ''
        if block.settings.offer == 'offer_1'
          assign card_offer_type = settings.ks_offer_1_type
        else
          assign card_offer_type = settings.ks_offer_2_type
        endif
        capture card_offer
          render 'ks-offer-text', type: card_offer_type
        endcapture
        assign card_offer = card_offer | strip
        if card_offer != ''
          assign card_text = '<p>' | append: card_offer | append: '</p>'
        else
          assign card_show = false
        endif
      endif
      if block.settings.heading != blank and card_show == false
        assign hidden_cards = hidden_cards | plus: 1
      endif
    -%}
    {%- if block.settings.heading != blank and card_show -%}
      <li
        class="ks-info-card{% if block.settings.image != blank %} ks-info-card--image{% endif %}"
        style="--ks-card-bg: {{ block.settings.background }};"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag: widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: '', loading: 'lazy', class: 'ks-info-card__bg'
          }}
        {%- endif -%}
        <div class="ks-info-card__inner">
          {%- if block.settings.icon != 'none' -%}
            <span class="ks-info-card__icon">{% render 'ks-icon', icon: block.settings.icon, size: 52 %}</span>
          {%- endif -%}
          <h3 class="ks-info-card__heading">{{ block.settings.heading }}</h3>
          {%- if card_text != blank -%}
            <div class="ks-info-card__text">{{ card_text }}</div>
          {%- endif -%}
          {%- assign new_tab = false -%}
          {%- if card_link contains 'http' -%}{%- assign new_tab = true -%}{%- endif -%}
          {% render 'ks-button', label: block.settings.button_label, url: card_link, new_tab: new_tab %}
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if cards != blank -%}
  {%- if request.design_mode and hidden_cards > 0 -%}
    <div class="ks-editor-note">KaffeSmak infokort: {{ hidden_cards }} kort visas inte för besökare (kategorin är opublicerad eller saknar produkter, eller erbjudandet saknar text).</div>
  {%- endif -%}
  {{ 'ks-theme.css' | asset_url | stylesheet_tag }}
  <section class="ks-section ks-info" style="--ks-info-bg: {{ section.settings.background }};">
    <div class="ks-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="ks-section__heading ks-section__heading--brown">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <ul class="ks-info__list" role="list">
        {{ cards }}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="ks-editor-note">KaffeSmak informationskort: {% if hidden_cards > 0 %}inget kort visas för besökare ännu ({{ hidden_cards }} kort väntar på att kategorin publiceras och har produkter, eller på erbjudandets text).{% else %}lägg till kort med rubrik.{% endif %} Sektionen syns inte för besökare utan innehåll.</div>
{%- endif -%}

{% schema %}
{
  "name": "KaffeSmak infokort",
  "class": "ks-info-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik" },
    { "type": "color", "id": "background", "label": "Bakgrund", "default": "#E2D8C8" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Kort",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            { "value": "none", "label": "Ingen" },
            { "value": "cup", "label": "Kaffekopp" },
            { "value": "beans", "label": "Kaffebönor" },
            { "value": "map", "label": "Karta" },
            { "value": "phone", "label": "Telefon" },
            { "value": "play", "label": "Film" }
          ],
          "default": "cup"
        },
        { "type": "text", "id": "heading", "label": "Rubrik" },
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "offer",
          "label": "Erbjudande",
          "options": [
            { "value": "none", "label": "Inget (texten ovan)" },
            { "value": "offer_1", "label": "Erbjudande 1 ur temainställningarna" },
            { "value": "offer_2", "label": "Erbjudande 2 ur temainställningarna" }
          ],
          "default": "none",
          "info": "Ersätter texten med kundens erbjudande (KaffeSmak › Erbjudanden)."
        },
        { "type": "text", "id": "button_label", "label": "Knapptext" },
        { "type": "url", "id": "link", "label": "Knapplänk", "info": "Tomt fält länkar till kategorin nedan." },
        { "type": "collection", "id": "collection", "label": "Kategori" },
        { "type": "checkbox", "id": "only_when_live", "label": "Visa bara när kategorin är publicerad och har produkter", "default": false },
        { "type": "image_picker", "id": "image", "label": "Bakgrundsbild (valfri)", "info": "Bilden tonas mörkt så att texten går att läsa." },
        { "type": "color", "id": "background", "label": "Kortets färg", "info": "Välj en färg som ger vit text tillräcklig kontrast (minst 4,5:1).", "default": "#8E6E43" }
      ]
    }
  ],
  "presets": [{ "name": "KaffeSmak infokort" }]
}
{% endschema %}
