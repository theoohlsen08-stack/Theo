{%- comment -%}
  KaffeSmak – varukorgssida (/cart) som referensens varukorg: brödsmulor "Hem › Varukorg", stor röd H1,
  grå ruta när varukorgen är tom och en rad med "‹ Fortsätt handla" till vänster och kassaknappen till höger.

  Fylld varukorg: ett vanligt Shopify-formulär (POST till /cart) med en tabell över raderna:
  bild, produktnamn (länk), variant och artikelnummer (bara när SKU finns), styckpris och jämförpris
  (bara när butiken har angett ett), antal (updates[]), radsumma och "Ta bort" (item.url_to_remove).
  "Uppdatera varukorg" skickar formuläret; ks-cart.js skickar det automatiskt en kort stund efter att
  antalet ändrats (aldrig med tomt fält eller 0), döljer då knappen och sätter tillbaka fokus efter omladdningen.
  "Gå vidare till kassan" är en vanlig submit-knapp med name="checkout" (Shopifys kassa).

  Medvetet utelämnat: rabattkodsfält, ordermeddelande och snabbkassaknappar (Shopify Pay m.fl.). Priser som är 0
  visas aldrig.
  Slututkast 2026-10-07: offertprodukter (snippet ks-sales-mode, Espressomaskin och Kaffekvarn) kan inte köpas. Hamnar
  en sådan rad ändå i varukorgen (t.ex. via en direktadress till /cart/add) visas en ruta överst och vid raden med
  länken "Begär offert" (snippet ks-quote-url) och "Ta bort", och kassaknappen är inaktiv så länge raden finns.
  Butiken nekar dessutom köp av dem eftersom lagret är 0 och "Fortsätt sälja när slut i lager" är avstängt.
  Kräver cart_type "page" i temainställningarna så att varukorgsikonen i sidhuvudet länkar hit.
{%- endcomment -%}

{{ 'ks-shop.css' | asset_url | stylesheet_tag }}
{{ 'ks-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ks-cart.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign heading = s.heading | default: 'Varukorg'
  assign continue_label = s.continue_label | default: 'Fortsätt handla'
  assign continue_url = s.continue_url | default: routes.all_products_collection_url
  assign checkout_label = s.checkout_label | default: 'Gå vidare till kassan'
  assign form_id = 'KsCartForm-' | append: section.id

  # Slututkast: antal rader med offertprodukter (kan inte köpas, kassaknappen blir inaktiv).
  assign quote_lines = 0
  for item in cart.items
    capture ks_sales
      render 'ks-sales-mode', product: item.product
    endcapture
    if ks_sales contains 'quote'
      assign quote_lines = quote_lines | plus: 1
    endif
  endfor
-%}

{%- capture continue_link -%}
  <a href="{{ continue_url }}" class="ks-cart__continue">
    <span class="ks-cart__continue-icon" aria-hidden="true">
      <svg width="8" height="12" viewBox="0 0 8 12" focusable="false"><path d="M6.5 1.5L2 6l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
    </span>
    {{- continue_label -}}
  </a>
{%- endcapture -%}

<div class="ks-shop ks-cart{% if cart.item_count == 0 %} ks-cart--empty{% endif %}" data-ks-cart>
  <div class="ks-container">
    {% render 'ks-breadcrumb', current: heading %}
    <h1 class="ks-page-title ks-cart__title">{{ heading }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="ks-empty-box ks-cart__empty">
        <p>{{ s.empty_text | default: 'Din varukorg är tom.' }}</p>
      </div>
      {%- comment -%} Läser upp "Produkten är borttagen …" när sista raden just tagits bort (ks-cart.js). {%- endcomment -%}
      <div class="ks-visually-hidden" role="status" aria-live="polite" data-ks-cart-status></div>
      <div class="ks-cart__actions">
        {{ continue_link }}
        {%- if s.show_disabled_checkout -%}
          <div class="ks-cart__checkout">
            {% render 'ks-button', label: checkout_label, disabled: true, class: 'ks-cart__checkout-button' %}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- if quote_lines > 0 -%}
        <div class="ks-cart__quote-alert" id="{{ form_id }}-quote-alert" role="alert" data-ks-cart-quote-alert>
          <p class="ks-cart__quote-alert-heading">
            {%- if quote_lines == 1 -%}En produkt i varukorgen säljs via offert{%- else -%}{{ quote_lines }} produkter i varukorgen säljs via offert{%- endif -%}
          </p>
          <p>Offertprodukter kan inte köpas i webbutiken. Skicka en offertförfrågan i stället och ta bort {% if quote_lines == 1 %}raden{% else %}raderna{% endif %} för att gå vidare till kassan.</p>
        </div>
      {%- endif -%}
      <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="ks-cart__form" novalidate data-ks-cart-form>
        <table class="ks-cart__table">
          <caption class="ks-visually-hidden">Produkter i varukorgen</caption>
          <thead class="ks-cart__head">
            <tr>
              <th scope="col" colspan="2" class="ks-cart__th ks-cart__th--product">Produkt</th>
              <th scope="col" class="ks-cart__th ks-cart__th--price">Pris</th>
              <th scope="col" class="ks-cart__th ks-cart__th--qty">Antal</th>
              <th scope="col" class="ks-cart__th ks-cart__th--total">Summa</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              {%- liquid
                assign line_name = item.product.title
                unless item.product.has_only_default_variant
                  assign line_name = line_name | append: ' – ' | append: item.variant.title
                endunless
                assign qty_id = form_id | append: '-qty-' | append: forloop.index
                capture line_sales
                  render 'ks-sales-mode', product: item.product
                endcapture
                assign line_quote = false
                if line_sales contains 'quote'
                  assign line_quote = true
                  capture line_quote_url
                    render 'ks-quote-url', product: item.product, variant: item.variant
                  endcapture
                  assign line_quote_url = line_quote_url | strip
                endif
                # Utan JavaScript tar 0 + "Uppdatera varukorg" bort raden. ks-cart.js höjer min till 1 (raden tas bort med "Ta bort").
                assign qty_min = 0
                assign qty_step = 1
                assign qty_max = ''
                if item.variant.quantity_rule.increment > 1
                  assign qty_step = item.variant.quantity_rule.increment
                endif
                if item.variant.quantity_rule.max != blank
                  assign qty_max = item.variant.quantity_rule.max
                endif
              -%}
              <tr class="ks-cart__row{% if line_quote %} ks-cart__row--quote{% endif %}" data-ks-cart-line="{{ forloop.index }}" data-ks-cart-key="{{ item.key | escape }}">
                <td class="ks-cart__media">
                  {%- if item.image != blank -%}
                    <a href="{{ item.url }}" class="ks-cart__media-link" tabindex="-1" aria-hidden="true">
                      {{
                        item.image
                        | image_url: width: 240
                        | image_tag: class: 'ks-cart__img', alt: '', loading: 'lazy', width: 80, height: 80
                      }}
                    </a>
                  {%- endif -%}
                </td>
                <td class="ks-cart__details">
                  <a href="{{ item.url }}" class="ks-cart__name" data-ks-cart-control="name">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    {%- for option in item.options_with_values -%}
                      <p class="ks-cart__meta">{{ option.name | strip }}: {{ option.value }}</p>
                    {%- endfor -%}
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation != blank -%}
                    <p class="ks-cart__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}
                  {%- for property in item.properties -%}
                    {%- assign prop_first = property.first | slice: 0 -%}
                    {%- if property.last != blank and prop_first != '_' -%}
                      <p class="ks-cart__meta">{{ property.first }}: {{ property.last }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if s.show_sku and item.sku != blank -%}
                    <p class="ks-cart__meta ks-cart__sku">Artikelnummer: {{ item.sku }}</p>
                  {%- endif -%}
                  {%- if line_quote -%}
                    <div class="ks-cart__quote-note" data-ks-cart-quote-note>
                      <p>Säljs via offert och kan inte köpas här.</p>
                      <a href="{{ line_quote_url | escape }}" class="ks-link ks-cart__quote-link" aria-label="Begär offert på {{ item.product.title | escape }}"><span aria-hidden="true">›&nbsp;</span>Begär offert</a>
                    </div>
                  {%- endif -%}
                  {%- for allocation in item.line_level_discount_allocations -%}
                    {%- if allocation.amount > 0 -%}
                      <p class="ks-cart__meta ks-cart__discount">{{ allocation.discount_application.title }} (−{{ allocation.amount | money }})</p>
                    {%- endif -%}
                  {%- endfor -%}
                </td>
                <td class="ks-cart__price">
                  {%- if item.final_price > 0 -%}
                    <span class="ks-cart__cell-label" aria-hidden="true">Pris</span>
                    {%- if item.original_price > item.final_price -%}
                      <s class="ks-cart__was"><span class="ks-visually-hidden">Ordinarie pris </span>{{ item.original_price | money }}</s>
                    {%- endif -%}
                    {% render 'ks-price', price: item.final_price %}
                    {%- comment -%} Jämförpris (enhetspris) bara när butiken har angett det för varianten. {%- endcomment -%}
                    {%- if item.unit_price_measurement and item.unit_price > 0 -%}
                      <span class="ks-cart__unit-price">Jämförpris {{ item.unit_price | money }}/{% if item.unit_price_measurement.reference_value != 1 %}{{ item.unit_price_measurement.reference_value }}{% endif %}{{ item.unit_price_measurement.reference_unit }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </td>
                <td class="ks-cart__qty">
                  <div class="ks-cart__qty-wrap">
                    {%- if line_quote -%}
                      {%- comment -%}
                        Slututkast: offertrader har ingen antalsväljare (kundens besked: ingen möjlighet att lägga
                        offertprodukterna i varukorgen). Antalet visas som text; det dolda updates[] håller ordningen så
                        att "Uppdatera varukorg" gäller rätt rader. Bara "Ta bort" finns kvar.
                      {%- endcomment -%}
                      <span class="ks-cart__qty-text">Antal: {{ item.quantity }}</span>
                      <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                    {%- else -%}
                    <label for="{{ qty_id }}" class="ks-visually-hidden">Antal av {{ line_name | escape }}</label>
                    <div class="ks-qty ks-cart__stepper">
                      <button type="button" class="ks-qty__button" data-ks-qty-step="-1" data-ks-cart-control="minus" aria-controls="{{ qty_id }}" aria-label="Minska antal av {{ line_name | escape }}" hidden>
                        <svg width="14" height="2" viewBox="0 0 14 2" aria-hidden="true" focusable="false"><path d="M0 1h14" stroke="currentColor" stroke-width="2"/></svg>
                      </button>
                      <input
                        type="number"
                        class="ks-control ks-qty__input"
                        id="{{ qty_id }}"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="{{ qty_min }}"
                        step="{{ qty_step }}"
                        {% if qty_max != '' %}
                          max="{{ qty_max }}"
                        {% endif %}
                        inputmode="numeric"
                        data-ks-qty-input
                        data-ks-cart-control="qty"
                      >
                      <button type="button" class="ks-qty__button" data-ks-qty-step="1" data-ks-cart-control="plus" aria-controls="{{ qty_id }}" aria-label="Öka antal av {{ line_name | escape }}" hidden>
                        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M0 7h14M7 0v14" stroke="currentColor" stroke-width="2"/></svg>
                      </button>
                    </div>
                    {%- endif -%}
                    <a href="{{ item.url_to_remove }}" class="ks-cart__remove" data-ks-cart-control="remove" data-ks-cart-remove aria-label="Ta bort {{ line_name | escape }} från varukorgen">Ta bort</a>
                  </div>
                </td>
                <td class="ks-cart__total">
                  {%- if item.final_line_price > 0 -%}
                    <span class="ks-cart__cell-label" aria-hidden="true">Summa</span>
                    {%- if item.original_line_price > item.final_line_price -%}
                      <s class="ks-cart__was"><span class="ks-visually-hidden">Ordinarie summa </span>{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    {% render 'ks-price', price: item.final_line_price %}
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="ks-cart__footer">
          <div class="ks-cart__update-wrap">
            <button type="submit" class="ks-cart__update" data-ks-cart-update>
              {{- s.update_label | default: 'Uppdatera varukorg' -}}
            </button>
            <div class="ks-cart__status" role="status" aria-live="polite" data-ks-cart-status></div>
          </div>

          <div class="ks-cart__totals">
            {%- for application in cart.cart_level_discount_applications -%}
              {%- if application.total_allocated_amount > 0 -%}
                <p class="ks-cart__cart-discount">{{ application.title }}: −{{ application.total_allocated_amount | money }}</p>
              {%- endif -%}
            {%- endfor -%}
            {%- if cart.total_price > 0 -%}
              <p class="ks-cart__subtotal">
                <span class="ks-cart__subtotal-label">Delsumma</span>
                {% render 'ks-price', price: cart.total_price, class: 'ks-cart__subtotal-price' %}
              </p>
            {%- endif -%}
            <p class="ks-cart__tax-note">
              {%- if cart.taxes_included -%}
                Moms ingår. Frakt beräknas i kassan.
              {%- else -%}
                Moms och frakt beräknas i kassan.
              {%- endif -%}
            </p>
          </div>
        </div>

        <div class="ks-cart__actions">
          {{ continue_link }}
          <div class="ks-cart__checkout">
            {%- if quote_lines > 0 -%}
              {% render 'ks-button', label: checkout_label, disabled: true, class: 'ks-cart__checkout-button' %}
              <p class="ks-cart__checkout-note">Ta bort offertprodukterna för att gå vidare till kassan.</p>
            {%- else -%}
              {% render 'ks-button', label: checkout_label, tag: 'button', button_type: 'submit', name: 'checkout', class: 'ks-cart__checkout-button' %}
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KaffeSmak varukorg",
  "class": "ks-cart-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Varukorg" },
    { "type": "text", "id": "empty_text", "label": "Text när varukorgen är tom", "default": "Din varukorg är tom." },
    { "type": "text", "id": "continue_label", "label": "Text på länken tillbaka till butiken", "default": "Fortsätt handla" },
    { "type": "url", "id": "continue_url", "label": "Länk tillbaka till butiken", "default": "/collections/all", "info": "Tomt fält länkar till alla produkter." },
    { "type": "text", "id": "checkout_label", "label": "Text på kassaknappen", "default": "Gå vidare till kassan" },
    { "type": "text", "id": "update_label", "label": "Text på uppdateringsknappen", "default": "Uppdatera varukorg", "info": "Knappen visas bara när JavaScript är avstängt; annars uppdateras varukorgen automatiskt när antalet ändras." },
    { "type": "checkbox", "id": "show_sku", "label": "Visa artikelnummer (bara när produkten har ett)", "default": true },
    { "type": "checkbox", "id": "show_disabled_checkout", "label": "Visa en grå, inaktiv kassaknapp när varukorgen är tom", "default": true }
  ]
}
{% endschema %}
