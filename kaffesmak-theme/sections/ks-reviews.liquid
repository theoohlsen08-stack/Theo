{%- comment -%}
  KaffeSmak – Google-recensioner (referensens beige recensionsfält).
  Sektionen visas för besökare ENDAST när "Recensionerna är verifierade" är ikryssat OCH det finns
  minst en recension, en app-widget eller ett verifierat sammanfattningsbetyg.
  Varje recension läggs in som ett eget block med recensentens namn, betyg, datum och originaltext
  ordagrant från den verifierade källan. Lägg aldrig in exempeltexter här.
  En recensionsapp (t.ex. en Google-recensionsintegration) kan läggas till som appblock.
{%- endcomment -%}


{%- liquid
  assign review_count = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.author != blank
      assign review_count = review_count | plus: 1
    elsif block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
  assign has_summary = false
  if section.settings.rating_value != blank and section.settings.rating_count != blank
    assign has_summary = true
  endif
  assign has_content = false
  if review_count > 0 or app_count > 0 or has_summary
    assign has_content = true
  endif
  assign show = false
  if section.settings.verified and has_content
    assign show = true
  endif
-%}

{%- if show -%}
  {{ 'ks-theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ks-carousel.js' | asset_url }}" defer></script>
  <section class="ks-section ks-reviews" aria-labelledby="KsReviews-{{ section.id }}" style="--ks-reviews-bg: {{ section.settings.background }};">
    <div class="ks-container">
      <h2 class="ks-section__heading ks-section__heading--brown" id="KsReviews-{{ section.id }}">{{ section.settings.heading }}</h2>

      {%- if has_summary -%}
        <p class="ks-reviews__summary">
          <span class="ks-reviews__stars" aria-hidden="true">
            {%- render 'ks-icon', icon: 'star', size: 22 -%}
          </span>
          <span>
            <strong>{{ section.settings.rating_value }} av 5</strong>
            baserat på {{ section.settings.rating_count }} recensioner på {{ section.settings.source_name }}
            {%- if section.settings.rating_date != blank %} ({{ section.settings.rating_date }}){% endif -%}
          </span>
        </p>
      {%- endif -%}

      {%- if review_count > 0 -%}
        <ks-carousel class="ks-carousel" data-ks-carousel>
          <button type="button" class="ks-carousel__arrow ks-carousel__arrow--prev" data-ks-prev hidden>
            <span class="ks-visually-hidden">Föregående recensioner</span>
            {% render 'ks-icon', icon: 'chevron-left', size: 26 %}
          </button>
          <ul class="ks-carousel__track ks-reviews__list" role="list" data-ks-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and block.settings.author != blank -%}
                {%- assign rating = block.settings.rating -%}
                <li class="ks-review" {{ block.shopify_attributes }}>
                  <article aria-label="Recension av {{ block.settings.author | escape }}">
                    <div class="ks-review__meta">
                      <span class="ks-review__stars" role="img" aria-label="{{ rating }} av 5 stjärnor">
                        {%- for i in (1..5) -%}
                          <span class="ks-review__star{% if i > rating %} ks-review__star--off{% endif %}">{% render 'ks-icon', icon: 'star', size: 16 %}</span>
                        {%- endfor -%}
                      </span>
                      {%- if block.settings.date != blank -%}
                        <span class="ks-review__date">{{ block.settings.date }}</span>
                      {%- endif -%}
                      <span class="ks-review__source">{{ block.settings.source | default: section.settings.source_name }}</span>
                    </div>
                    {%- assign words = block.settings.text | split: ' ' -%}
                    {%- if block.settings.text == blank -%}
                      <p class="ks-review__text ks-review__text--empty">Betyg utan skriven recension.</p>
                    {%- elsif words.size > 40 -%}
                      <details class="ks-review__details">
                        <summary>
                          <span class="ks-review__text ks-review__text--clamped">{{ block.settings.text | newline_to_br }}</span>
                          <span class="ks-review__more">Läs hela recensionen</span>
                        </summary>
                        <div class="ks-review__text">{{ block.settings.text | newline_to_br }}</div>
                      </details>
                    {%- else -%}
                      <p class="ks-review__text">{{ block.settings.text | newline_to_br }}</p>
                    {%- endif -%}
                    <p class="ks-review__author">{{ block.settings.author }}</p>
                  </article>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <button type="button" class="ks-carousel__arrow ks-carousel__arrow--next" data-ks-next hidden>
            <span class="ks-visually-hidden">Nästa recensioner</span>
            {% render 'ks-icon', icon: 'chevron-right', size: 26 %}
          </button>
        </ks-carousel>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="ks-reviews__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      <div class="ks-section__actions">
        {% render 'ks-button', label: section.settings.all_reviews_label, url: section.settings.all_reviews_link %}
        {% render 'ks-button', label: section.settings.write_review_label, url: section.settings.write_review_link, new_tab: true %}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="ks-editor-note">KaffeSmak Google-recensioner är dolda för besökare. De visas först när verifierade recensioner (eller en recensionsapp) har lagts in och rutan "Recensionerna är verifierade" är ikryssad.</div>
{%- endif -%}

{% schema %}
{
  "name": "KaffeSmak recensioner",
  "class": "ks-reviews-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "checkbox",
      "id": "verified",
      "label": "Recensionerna är verifierade och får visas",
      "info": "Kryssa i först när alla recensioner och betyg kommer från företagets verifierade Google-profil eller en godkänd recensionsintegration.",
      "default": false
    },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Så här säger våra kunder" },
    { "type": "text", "id": "source_name", "label": "Källa", "default": "Google" },
    { "type": "header", "content": "Sammanfattning (valfri)" },
    { "type": "text", "id": "rating_value", "label": "Genomsnittsbetyg", "info": "Till exempel 4,5. Lämna tomt om det inte är verifierat." },
    { "type": "text", "id": "rating_count", "label": "Antal recensioner" },
    { "type": "text", "id": "rating_date", "label": "Uppgiften gäller", "info": "Till exempel ett datum, så att besökaren ser hur aktuell uppgiften är." },
    { "type": "header", "content": "Knappar" },
    { "type": "text", "id": "all_reviews_label", "label": "Text: alla recensioner", "default": "Läs alla recensioner" },
    { "type": "url", "id": "all_reviews_link", "label": "Länk: alla recensioner", "info": "Recensionssida eller företagets Google-profil." },
    { "type": "text", "id": "write_review_label", "label": "Text: skriv recension", "default": "Lämna ditt omdöme på Google" },
    { "type": "url", "id": "write_review_link", "label": "Länk: skriv recension", "info": "Verifierad länk från företagets Google-profil." },
    { "type": "color", "id": "background", "label": "Bakgrund", "default": "#E2D8C8" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recension",
      "settings": [
        { "type": "paragraph", "content": "Klistra in recensionen ordagrant från den verifierade källan." },
        { "type": "text", "id": "author", "label": "Recensentens namn" },
        { "type": "range", "id": "rating", "label": "Betyg", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "date", "label": "Publiceringsdatum" },
        { "type": "textarea", "id": "text", "label": "Recensionstext (originaltext)", "info": "Lämna tomt för ett betyg utan text." },
        { "type": "text", "id": "source", "label": "Källa", "info": "Tomt fält använder sektionens källa." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [{ "name": "KaffeSmak recensioner" }]
}
{% endschema %}
